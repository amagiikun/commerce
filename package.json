{
  "name": "smart-commerce-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:client": "vite",
    "dev:server": "npm --prefix server run dev",
    "build": "vue-tsc -b && vite build",
    "build:server": "npm --prefix server run build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:server": "npm --prefix server run test",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "db:generate": "npm --prefix server run prisma:generate",
    "db:migrate": "npm --prefix server run prisma:migrate",
    "db:seed": "npm --prefix server run db:seed"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.11.0",
    "echarts": "^5.6.0",
    "element-plus": "^2.10.5",
    "pinia": "^3.0.3",
    "vue": "^3.5.20",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@vue/tsconfig": "^0.7.0",
    "@types/node": "^24.3.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.6"
  }
}
